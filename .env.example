# KOSOVO 2036 — HUMAN NETWORK — environment variables
#
# Never commit a real .env file or real credentials. Copy this to .env.local
# for local development (see docs/ARCHITECTURE.md "Database" for why SQLite
# is used here instead of the scope's suggested PostgreSQL).

# Required (Phase 2+). SQLite file DB — created by `npm run db:migrate`.
DATABASE_URL="file:./dev.db"

# Required (Phase 2+) in production. Signs session cookies (HS256 via jose).
# In development only, the app falls back to an insecure generated default
# and logs a warning if this is unset — it refuses to start without a real
# value when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Optional (Phase 3+): override MapLibre's style URL. Phase 1 hardcodes the
# public MapLibre demo style (no key required) in src/components/ActivityMap.tsx.
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
