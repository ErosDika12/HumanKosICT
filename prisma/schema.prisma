// KOSOVO 2036 — HUMAN NETWORK — Phase 2 schema.
//
// Datasource: SQLite (see docs/ARCHITECTURE.md "Database" for why this
// deviates from the scope's suggested PostgreSQL and how to switch later).
// All content that migrations seed is fictional 2036 demo data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Accounts, roles, safety
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  ORGANIZER
  MODERATOR
  MUNICIPALITY_ANALYST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(MEMBER)
  name         String
  nameSq       String?
  bio          String?
  bioSq        String?
  /// Opt-in only. Off by default — no field here is shown publicly unless
  /// this is explicitly true (see src/lib/data/profile.ts projections).
  isDiscoverable Boolean @default(false)
  /// Demo-only flag identifying seeded fictional personas vs. anything a
  /// visitor creates through /login in this prototype. Never used for
  /// authorization — role does that.
  isDemoPersona  Boolean @default(false)
  /// Fictional "demo friend" — a seeded, non-loginable persona a visitor can
  /// befriend, invite and message. Never a live person; replies are either
  /// seeded examples or the transparent availability rule (see
  /// src/lib/data/friends.ts).
  isDemoFriend   Boolean @default(false)
  /// One-click "Log in as demo" visitor — an isolated, ephemeral MEMBER
  /// account created per visitor and purged after a day. Excluded from
  /// public counts, matching and municipal aggregates.
  isDemoVisitor  Boolean @default(false)
  /// Neighborhood (matches Activity.areaSq values) and availability tags,
  /// e.g. "weekday-evenings,weekends" — used for friend suggestions.
  areaSq         String?
  availability   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  friendshipsOwned     Friendship[]      @relation("FriendshipUser")
  friendshipsReceived  Friendship[]      @relation("FriendshipFriend")
  invitesSent          ActivityInvite[]  @relation("InviteFrom")
  invitesReceived      ActivityInvite[]  @relation("InviteTo")
  messagesSent         Message[]         @relation("MessageSender")
  messagesReceived     Message[]         @relation("MessageRecipient")
  assistantUsage       AssistantUsage[]

  interests        UserInterest[]
  memberships      Membership[]
  organizedCommunities Community[]      @relation("CommunityOrganizer")
  organizedActivities  Activity[]       @relation("ActivityOrganizer")
  rsvps            Rsvp[]
  projectVolunteers ProjectVolunteer[]
  needsSubmitted    CommunityNeed[]     @relation("NeedSubmitter")
  needSupports      NeedSupport[]
  reportsFiled      Report[]            @relation("ReportReporter")
  reportsModerated  Report[]            @relation("ReportModerator")
  attendances       Attendance[]        @relation("AttendanceAttendee")
  attendancesConfirmed Attendance[]     @relation("AttendanceConfirmedBy")
  notifications     Notification[]
  bridgeDecisions   BridgeProposal[]    @relation("BridgeDecidedBy")
  blocksMade        Block[]             @relation("BlockBlocker")
  blocksReceived    Block[]             @relation("BlockBlocked")
  connectionsSent   ConnectionRequest[] @relation("ConnectionFrom")
  connectionsReceived ConnectionRequest[] @relation("ConnectionTo")
  reportsAboutMe    Report[]            @relation("ReportedUser")
  municipalityNotes MunicipalityRecommendationNote[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Interests (fixed catalog — ids/labels defined in src/lib/types.ts;
// this table exists only to give UserInterest / ActivityInterest a real FK).
// ---------------------------------------------------------------------------

model Interest {
  id      String @id // matches InterestId in src/lib/types.ts, e.g. "technology"
  labelEn String
  labelSq String
  emoji   String

  users      UserInterest[]
  activities ActivityInterest[]
}

model UserInterest {
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

// ---------------------------------------------------------------------------
// Communities & membership
// ---------------------------------------------------------------------------

enum ActivityCategory {
  SPORTS
  EDUCATION
  CULTURE
  COMMUNITY
  TECHNOLOGY
  ENVIRONMENT
}

enum Visibility {
  PUBLIC
  RESTRICTED
}

/// Discoverability/moderation state — distinct from Visibility (which
/// controls who can join a *discoverable* community). A community an
/// organizer just created defaults to DRAFT (hidden from /communities and
/// Discover's "Organized by" links) until a moderator publishes it — see
/// docs/PRODUCT_CONTRACT.md "do not make every new public event instantly
/// trusted by default." The 4 seeded Phase 1 communities are seeded
/// explicitly as PUBLISHED.
enum CommunityStatus {
  DRAFT
  PUBLISHED
}

model Community {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  nameSq      String?
  category    ActivityCategory
  description   String
  descriptionSq String
  areaSq      String
  /// Free-text primary language(s) the community operates in, e.g.
  /// "Albanian, English" — shown on the community detail page.
  language    String?
  /// Free-text community guidelines shown on the detail page.
  rules       String?
  visibility  Visibility      @default(PUBLIC)
  status      CommunityStatus @default(DRAFT)
  /// Demo-only "verified organizer" badge, matching the Phase 1 seed data's
  /// organizer.verified flag. Not a real verification process.
  verified    Boolean    @default(false)
  organizerId String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organizer   User          @relation("CommunityOrganizer", fields: [organizerId], references: [id])
  memberships Membership[]
  activities  Activity[]
  projects    Project[]
  needs       CommunityNeed[]
  bridgeAsA   BridgeProposal[] @relation("BridgeCommunityA")
  bridgeAsB   BridgeProposal[] @relation("BridgeCommunityB")
}

enum MembershipRole {
  MEMBER
  ORGANIZER
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  communityId String
  role        MembershipRole   @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
}

// ---------------------------------------------------------------------------
// Activities (events) & RSVPs
// ---------------------------------------------------------------------------

enum AgeEligibility {
  ALL_AGES
  ADULTS_ONLY
  SUPERVISED_MINORS
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum Cost {
  FREE
  PAID
}

enum ActivityStatus {
  /// Organizer-created, awaiting moderator publish — never appears in
  /// listActivities()'s discovery results. See CommunityStatus.DRAFT.
  DRAFT
  PUBLISHED
  CANCELED
}

model Activity {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleSq     String
  summary     String
  summarySq   String
  category    ActivityCategory
  areaSq      String
  areaEn      String
  venueName   String
  /// Approximate public coordinates for a public venue — never a private
  /// user location. See docs/PRODUCT_CONTRACT.md non-negotiable boundaries.
  lat         Float
  lng         Float
  date        String // ISO date "2036-06-13" — Kosovo has one civil timezone, stored + displayed as Europe/Prishtina (see docs/ARCHITECTURE.md).
  startTime   String // "18:00" local Europe/Prishtina time
  timezone    String   @default("Europe/Prishtina")
  capacity    Int
  /// Fictional 2036-scenario attendance baseline seeded alongside the
  /// activity itself — distinct from real Rsvp rows created by demo
  /// accounts through this app. Documented in docs/DEMO_DATA.md. Real
  /// capacity enforcement always adds confirmed Rsvp rows on top of this.
  simulatedRsvpBaseline Int @default(0)
  cost        Cost
  costDetail  String?
  indoor      Boolean
  accessibility String // comma-separated tags (SQLite has no native array type)
  ageEligibility AgeEligibility
  difficulty  Difficulty
  status      ActivityStatus @default(PUBLISHED)
  description   String
  descriptionSq String
  organizerId String
  communityId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer  User               @relation("ActivityOrganizer", fields: [organizerId], references: [id])
  community  Community          @relation(fields: [communityId], references: [id])
  interests  ActivityInterest[]
  rsvps      Rsvp[]
  reports    Report[]
  attendances Attendance[]
  notifications Notification[]
  invites    ActivityInvite[]
  bridgeKickoffs BridgeProposal[] @relation("BridgeKickoff")

  @@index([category])
  @@index([communityId])
}

model ActivityInterest {
  activityId String
  interestId String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([activityId, interestId])
}

enum RsvpStatus {
  CONFIRMED
  CANCELED
}

model Rsvp {
  id         String     @id @default(cuid())
  userId     String
  activityId String
  status     RsvpStatus @default(CONFIRMED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
  @@index([activityId, status])
}

/// Organizer-confirmed attendance — deliberately separate from Rsvp (an
/// intent to attend) per the Phase 4 brief. There is no self-check-in: only
/// the activity's organizer can create a row here, via
/// src/lib/data/attendance.ts, and only for an activity whose date has
/// already passed on the simulated clock (src/lib/simulated-clock.ts) —
/// confirming attendance at an event that (in-universe) hasn't happened yet
/// wouldn't mean anything. No hours field: this app tracks whether someone
/// attended, never a self-reported or fabricated duration.
model Attendance {
  id            String   @id @default(cuid())
  userId        String
  activityId    String
  confirmedById String
  checkedInAt   DateTime @default(now())

  user        User     @relation("AttendanceAttendee", fields: [userId], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  confirmedBy User     @relation("AttendanceConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([userId, activityId])
}

// ---------------------------------------------------------------------------
// In-app notifications (Phase 4) — no external messaging dependency.
// ---------------------------------------------------------------------------

model Notification {
  id         String    @id @default(cuid())
  userId     String
  message    String
  activityId String?
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Projects (Phase 4 UI, schema laid down now per Phase 2 mission)
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  COMPLETED
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  communityId String
  title       String
  titleSq     String
  description   String
  descriptionSq String
  status      ProjectStatus @default(ACTIVE)
  volunteersNeeded Int
  createdAt   DateTime      @default(now())

  community  Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  volunteers ProjectVolunteer[]
  bridgeProposal BridgeProposal? @relation("BridgeDraftProject")
}

enum VolunteerStatus {
  ACTIVE
  WITHDRAWN
}

model ProjectVolunteer {
  id        String          @id @default(cuid())
  userId    String
  projectId String
  status    VolunteerStatus @default(ACTIVE)
  joinedAt  DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// ---------------------------------------------------------------------------
// Community needs (Phase 4 UI / Phase 7 aggregation input)
// ---------------------------------------------------------------------------

enum NeedStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model CommunityNeed {
  id          String     @id @default(cuid())
  communityId String?
  category    ActivityCategory
  areaSq      String
  description String
  status      NeedStatus @default(OPEN)
  /// Never exposed in any public or municipality-facing projection —
  /// see src/lib/data/needs.ts and docs/PRODUCT_CONTRACT.md.
  submittedById String
  createdAt   DateTime   @default(now())

  community   Community?    @relation(fields: [communityId], references: [id], onDelete: SetNull)
  submittedBy User          @relation("NeedSubmitter", fields: [submittedById], references: [id])
  supports    NeedSupport[]
  reports     Report[]
  bridgeProposals BridgeProposal[]
}

/// "I also need this" — the Phase 4 brief's required alternative to letting
/// duplicate need submissions inflate a count. Unique per (userId, needId)
/// so supporting is idempotent, never a second row.
model NeedSupport {
  id        String   @id @default(cuid())
  userId    String
  needId    String
  createdAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  need CommunityNeed @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@unique([userId, needId])
}

// ---------------------------------------------------------------------------
// BRIDGE — deterministic, explainable cross-community collaboration
// proposals (Phase 5). See src/lib/data/bridge-scoring.ts for the scoring
// formula and src/lib/data/bridge.ts for generation/authorization/CRUD.
// ---------------------------------------------------------------------------

enum BridgeStatus {
  /// Machine-generated this run — regenerated/invalidated automatically as
  /// inputs change. Never an organizer decision.
  SUGGESTED
  /// An organizer explicitly kept this one without deciding yet.
  SAVED
  /// An organizer accepted it — draftProjectId is then set.
  ACCEPTED
  DECLINED
  /// A SUGGESTED proposal whose driving need resolved/disappeared, or that
  /// no longer scores above threshold — kept for audit, hidden from the
  /// active list. Never applied to a human SAVED/ACCEPTED/DECLINED decision.
  INVALIDATED
}

model BridgeProposal {
  id            String       @id @default(cuid())
  communityAId  String
  communityBId  String
  /// The specific community need driving this proposal — BRIDGE always
  /// proposes something concrete, never an abstract pairing.
  needId        String
  /// Short, human-readable factors joined together, e.g. "Complementary
  /// categories (technology + environment); both serve Prishtinë — Dardania;
  /// directly addresses an open technology need." Never an opaque score.
  reason        String
  mutualBenefit String
  requiredResources String
  suggestedNextAction String
  /// Deterministic weighted score — see bridge-scoring.ts. Used for ranking
  /// and as the dedup/regeneration threshold, never shown as a bare number
  /// to avoid reading as an opaque "AI confidence."
  score         Float
  status        BridgeStatus @default(SUGGESTED)
  /// Set only once an organizer accepts — the resulting draft collaboration
  /// project. One proposal accepts into at most one project.
  draftProjectId String?     @unique
  /// First joint session of an accepted collaboration (an upcoming Activity),
  /// shown as the "next step" on the BRIDGE page.
  kickoffActivityId String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  communityA   Community      @relation("BridgeCommunityA", fields: [communityAId], references: [id], onDelete: Cascade)
  communityB   Community      @relation("BridgeCommunityB", fields: [communityBId], references: [id], onDelete: Cascade)
  need         CommunityNeed  @relation(fields: [needId], references: [id], onDelete: Cascade)
  draftProject Project?       @relation("BridgeDraftProject", fields: [draftProjectId], references: [id])
  kickoffActivity Activity?   @relation("BridgeKickoff", fields: [kickoffActivityId], references: [id], onDelete: SetNull)
  decidedBy    User?          @relation("BridgeDecidedBy", fields: [decidedById], references: [id])

  @@unique([communityAId, communityBId, needId])
}

// ---------------------------------------------------------------------------
// Human matching (Phase 5) — opt-in only (reuses User.isDiscoverable as the
// single consent flag for both public profile visibility and matchability
// — see docs/ARCHITECTURE.md "Human matching"), adult-only by construction
// (no minor ever has an account — see docs/PRODUCT_CONTRACT.md), never
// exposes exact location or private contact fields.
// ---------------------------------------------------------------------------

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A "mutual interest or participation" precondition (shared interest tag,
/// shared community membership, or shared project) is checked server-side
/// before a request can be created — see src/lib/data/people.ts.
model ConnectionRequest {
  id         String           @id @default(cuid())
  fromUserId String
  toUserId   String
  reason     String
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  decidedAt  DateTime?

  fromUser User @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

// ---------------------------------------------------------------------------
// Safety / moderation
// ---------------------------------------------------------------------------

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  activityId   String?
  needId       String?
  /// A person, not a post — the human-matching block/report requirement.
  reportedUserId String?
  reason       String
  status       ReportStatus @default(OPEN)
  moderatorId  String?
  moderatorNote String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  reporter     User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator    User?          @relation("ReportModerator", fields: [moderatorId], references: [id])
  activity     Activity?      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  need         CommunityNeed? @relation(fields: [needId], references: [id], onDelete: Cascade)
  reportedUser User?          @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Friends, invitations, plans and direct messages (Phase 9). Everything a
// visitor does here is stored per account, so one-click demo visitors are
// isolated from each other. Fictional demo friends never "reply live".
// ---------------------------------------------------------------------------

model Friendship {
  id              String   @id @default(cuid())
  userId          String
  friendId        String
  /// Seeded example friendship, shown labeled as demo content.
  isSeededExample Boolean  @default(false)
  createdAt       DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// "Come with me" — a plan is an activity plus the invitations attached to it.
model ActivityInvite {
  id         String       @id @default(cuid())
  activityId String
  fromUserId String
  toUserId   String
  message    String?
  status     InviteStatus @default(PENDING)
  /// True when the recipient is a fictional demo friend and the status came
  /// from the transparent availability rule, never from a live person.
  isSimulatedReply Boolean @default(false)
  replyNote  String?
  isSeededExample Boolean @default(false)
  createdAt  DateTime     @default(now())
  respondedAt DateTime?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  from     User     @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to       User     @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([activityId, fromUserId, toUserId])
  @@index([toUserId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  /// Seeded demo conversation line — labeled in the UI, never live.
  isSeededExample Boolean @default(false)
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// Per-user, per-day assistant usage counter (server-side usage limit).
model AssistantUsage {
  id     String @id @default(cuid())
  userId String
  day    String // "YYYY-MM-DD" real UTC day, unrelated to the simulated clock
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ---------------------------------------------------------------------------
// Municipality intelligence (Phase 7) — aggregate-only, defensible privacy.
// See src/lib/data/municipality-aggregation.ts and docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

/// A separate, explicitly-labeled SYNTHETIC aggregate dataset — never
/// derived from real User/CommunityNeed/NeedSupport rows, and structurally
/// incapable of identifying anyone (no relation to User at all). Exists
/// only so the municipality demo story is demonstrable at a realistic
/// scale ("several simulated requests... relatively few relevant events")
/// without fabricating individual accounts to inflate a real count. Never
/// blended into the real demand aggregation in
/// src/lib/data/municipality-aggregation.ts — always shown in a separately
/// labeled "scenario projection" section.
model MunicipalityScenarioDemand {
  id             String           @id @default(cuid())
  areaSq         String
  category       ActivityCategory
  /// A scenario-level request count for this demo narrative — not a count
  /// of any real row, ever.
  syntheticCount Int
  note           String
  createdAt      DateTime         @default(now())

  @@unique([areaSq, category])
}

/// An analyst's own editable draft text for a "suggestion for human
/// review" (never an automatic decision, never a real Activity/Project —
/// analysts have no organizing authority in this app's role model). Free
/// text the analyst themselves authored; not a private user record.
model MunicipalityRecommendationNote {
  id          String           @id @default(cuid())
  areaSq      String
  category    ActivityCategory
  text        String
  updatedById String
  updatedAt   DateTime         @updatedAt

  updatedBy User @relation(fields: [updatedById], references: [id])

  @@unique([areaSq, category])
}
