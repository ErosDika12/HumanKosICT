# KOSOVO 2036 — HUMAN NETWORK — environment variables
#
# Never commit a real .env file or real credentials. Copy this to .env.local
# for local development. .env* files are git-ignored (only this example is
# tracked). See docs/DEPLOYMENT.md for the hosted (Vercel + PostgreSQL) setup.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (default): SQLite file, created by `npm run db:migrate`.
DATABASE_URL="file:./prisma/dev.db"
#
# Hosted (Vercel): a PostgreSQL URL selects the PostgreSQL client automatically.
# Use the provider's connection pooler in SESSION mode (IPv4-compatible), with
# NO sslmode/ssl parameters — TLS certificates are always verified (the Supabase
# root CA is built in; use DATABASE_SSL_CA for other providers).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# DATABASE_SSL_CA=""            # optional PEM for non-Supabase providers
# DATABASE_POOL_MAX=4           # connections per serverless instance

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs session cookies (HS256 via jose). In development the app falls back to
# an insecure generated default and warns; it REFUSES to start without a real
# value when NODE_ENV=production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------
# Password for the seeded organizer / moderator / municipality-analyst
# accounts. Local dev and tests default to a documented value; in a hosted
# environment set a private one — it is never shown on the public site.
# DEMO_STAFF_PASSWORD=""
# Set to 1 to turn the public "Log in as demo" button off.
# DEMO_LOGIN_DISABLED=1

# ---------------------------------------------------------------------------
# Assistant (optional — it works without any of these)
# ---------------------------------------------------------------------------
# With no key the assistant is a rules-based, grounded helper and says so.
# Setting a key lets an AI model PHRASE replies from the same stored facts
# (server-side only, per-account daily limits below).
# ASSISTANT_AI_API_KEY=""       # alias: AI_GATEWAY_API_KEY
# ASSISTANT_AI_PROVIDER="gateway"
# ASSISTANT_AI_BASE_URL="https://ai-gateway.vercel.sh/v1"
# ASSISTANT_AI_MODEL="anthropic/claude-haiku-4.5"
# ASSISTANT_DAILY_LIMIT=60      # all assistant messages per account per day
# ASSISTANT_AI_DAILY_LIMIT=20   # of which may use the AI provider

# ---------------------------------------------------------------------------
# Map
# ---------------------------------------------------------------------------
# Optional. Overrides the map style/tile source (default: OpenFreeMap's public
# OpenStreetMap-based style, no key required).
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
